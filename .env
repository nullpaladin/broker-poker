# Comma-separated rights to exercise. Unset/empty => RIGHT_TO_ACCESS, RIGHT_TO_OPT_OUT,
# RIGHT_TO_LIST_OF_THIRD_PARTIES. Deletion is destructive, so it only runs if you add
# RIGHT_TO_DELETE explicitly. Valid: RIGHT_TO_ACCESS, RIGHT_TO_OPT_OUT, RIGHT_TO_DELETE,
# RIGHT_TO_LIST_OF_THIRD_PARTIES. Every right is further gated by whether your STATE's
# privacy law grants it (no-law states still try them all); rights a state's law doesn't
# grant are skipped automatically. (The UI will eventually write this setting.)
RIGHTS_TO_EXERCISE="RIGHT_TO_ACCESS,RIGHT_TO_OPT_OUT,RIGHT_TO_LIST_OF_THIRD_PARTIES"
DRY_RUN=True # Set to "False" if you want to submit the request
HEALTH_CHECK=False # Like DRY_RUN but asserts required fields are fillable and the form still offers the same rights
HEADLESS_BROWSER_MODE=False # Set to `True` to hide the browser window (a visible window is needed for manual CAPTCHA solves on a live run)
BASE_TIMEOUT_IN_SECONDS=10
TWO_CAPTCHA_API_KEY="asdf"
ADVERTISING_ID="0000-0000-0000-0000" # UUID - MAID for Android and ???? for iOS, very hard to fidn on iOS
CHROMIUM_LOCATION="/usr/bin/chromium"
