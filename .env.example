# Comma-separated canonical right codes to exercise. Unset/empty => all of them.
# Valid: access, delete, correct, portability, opt_out_sale_share,
#        opt_out_targeted_ads, opt_out_profiling, know_third_parties, limit_sensitive_pi
# `delete` is additionally gated by REMOVE_INFORMATION below, and every right is
# gated by whether your STATE's privacy law grants it (no-law states still try the
# generic set). Rights a state's law doesn't grant are skipped automatically.
REQUESTED_RIGHTS=""
REMOVE_INFORMATION=False # Set to `True` if you want your information removed
DRY_RUN=True # Set to "False" if you want to submit the request
